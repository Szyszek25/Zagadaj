{
  "expo": {
    "name": "Zagadaj",
    "slug": "zagadaj",
    "scheme": "zagadaj",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFAF8"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
